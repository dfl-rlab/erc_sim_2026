      <mass value="0.70767"/>
      <inertia ixx="0.00035492" ixy="7.5685e-13" ixz="3.8795E-11" iyy="0.00035529" iyz="-2.0284e-07" izz="0.00040131"/>
    </inertial>
    <visual>
